__/vcpp/SDL_win32_main.c.i:
	cd /home/hatch/workspace/shattered-shield/build-win-v17 && $(MAKE) $(MAKESILENT) -f src/client/CMakeFiles/client_win64_x64.dir/build.make src/client/CMakeFiles/client_win64_x64.dir/__/vcpp/SDL_win32_main.c.i
.PHONY : __/vcpp/SDL_win32_main.c.i

__/vcpp/SDL_win32_main.s: __/vcpp/SDL_win32_main.c.s
.PHONY : __/vcpp/SDL_win32_main.s

# target to generate assembly for a file
__/vcpp/SDL_win32_main.c.s:
